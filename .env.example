# AWS configuration.
export AWS_DEFAULT_REGION="us-east-2"
export AWS_S3_BUCKET_NAME="plakar-demo-backups"

# Cluster configuration.
export CLUSTER_NAME="plakar-demo"
export CLUSTER_VERSION="1.37"
export CLUSTER_HOST_PORT="8000"

# PCP IAM ROLE name, adjust this to yours after the Plakar Control Plane is up
# and running with an attached IAM role.
export PLAKAR_CONTROL_PLANE_EC2_IAM_ROLE_NAME="plakar-demo-control-plane"

# https://github.com/kubernetes-sigs/gateway-api/releases
export KUBERNETES_GATEWAY_API_VERSION="1.6.2"

# https://github.com/nginx/nginx-gateway-fabric/releases
export NGINX_GATEWAY_FABRIC_VERSION="2.8.0"

# https://github.com/kubernetes-csi/csi-driver-nfs/releases
export NFS_CSI_DRIVER_VERSION="4.13.6"

# https://www.plakar.io/docs/control-plane/infrastructure-as-code/kubernetes-operator/installation/
export PLAKAR_KUBERNETES_OPERATOR_VERSION="0.2.0"

# Adjust this as needed if you're not using kind with NGINX.
export K8S_GATEWAY_CLASS_NAME="nginx"

# Adjust this as needed if you're not using EFS with EKS.
export K8S_STORAGE_CLASS_NAME="efs-csi"

# Port forwarding will be set up and services will be accessible on these hosts.
export K8S_ECHO_HOSTNAME="echo.localhost"
export K8S_WORDPRESS_HOSTNAME="wordpress.localhost"

# Plakar Kubernetes Operator configuration, the inventory UUID is optional,
# feel free to omit it and let the operator create one for you. If you add one
# you'll need to adjust the config in: 03-plakar-operator/01-plakar.yaml.
export PLAKAR_KUBERNETES_OPERATOR_PCP_URL="https://pcp.example.com/"
export PLAKAR_KUBERNETES_OPERATOR_INVENTORY_UUID=

# Plakar source IDs. You'll be able to fill these out after you've created
# the sources through the operator. You can find them in the PCP UI for
# mariadb-pvc and wordpress-pvc after expanding the item in the "Apps" tab.
export PLAKAR_SOURCE_ID_WORDPRESS=
export PLAKAR_SOURCE_ID_MARIADB=
