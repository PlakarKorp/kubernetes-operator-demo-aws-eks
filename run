#!/usr/bin/env bash
# Helper script to manage the cluster.

set -o errexit
set -o pipefail
set -o nounset

# shellcheck disable=SC1091
[ -f .env ] && . .env

export AWS_PAGER=""
export AWS_REGION="us-east-2"
export AWS_DEFAULT_REGION="${AWS_REGION}"

# -----------------------------------------------------------------------------
# Helper functions start with _ and aren't listed in this script's help menu.
# -----------------------------------------------------------------------------

_print_header() {
  echo
  echo "======================================================================"
  echo "${1}"
  echo "======================================================================"
}

_kubectl:file() {
  local action="${1}"
  local config_path="${2}"
  shift 2

  envsubst <"${config_path}" | kubectl "${action}" "${@}" -f -
}

_delete_iam_role() {
  local role_name="${1}"
  local attached_policies
  local inline_policies
  local policy_arn
  local policy_name

  if ! aws iam get-role --role-name "${role_name}" >/dev/null 2>&1; then
    printf "IAM role does not exist: %s\n" "${role_name}"
    return
  fi

  printf "Deleting IAM role: %s\n" "${role_name}"

  attached_policies=$(aws iam list-attached-role-policies \
    --role-name "${role_name}" \
    --query "AttachedPolicies[].PolicyArn" \
    --output text)

  if [[ -n "${attached_policies}" && "${attached_policies}" != "None" ]]; then
    read -r -a policy_arns <<<"${attached_policies}"

    for policy_arn in "${policy_arns[@]}"; do
      aws iam detach-role-policy \
        --role-name "${role_name}" \
        --policy-arn "${policy_arn}"
    done
  fi

  inline_policies=$(aws iam list-role-policies \
    --role-name "${role_name}" \
    --query "PolicyNames[]" \
    --output text)

  if [[ -n "${inline_policies}" && "${inline_policies}" != "None" ]]; then
    read -r -a policy_names <<<"${inline_policies}"

    for policy_name in "${policy_names[@]}"; do
      aws iam delete-role-policy \
        --role-name "${role_name}" \
        --policy-name "${policy_name}"
    done
  fi

  aws iam delete-role --role-name "${role_name}"
}

# -----------------------------------------------------------------------------

cluster:kind:create() {
  envsubst <kind-config.yaml | kind create cluster --name "${CLUSTER_NAME}" --config -
  docker container update --restart=no "${CLUSTER_NAME}-control-plane"
}

cluster:create() {
  export KUBERNETES_VERSION="${CLUSTER_VERSION}"
  export NODEGROUP_NAME="${CLUSTER_NAME}-workers"
  export NODE_INSTANCE_TYPE="t3.medium"

  export VPC_CIDR="10.100.0.0/16"
  export SUBNET_A_CIDR="10.100.1.0/24"
  export SUBNET_B_CIDR="10.100.2.0/24"

  export VPC_NAME="${CLUSTER_NAME}"
  export SUBNET_A_NAME="${CLUSTER_NAME}-subnet-a"
  export SUBNET_B_NAME="${CLUSTER_NAME}-subnet-b"
  export IGW_NAME="${CLUSTER_NAME}-internet-gateway"
  export ROUTE_TABLE_NAME="${CLUSTER_NAME}-route-table"

  _print_header "CREATE VPC"

  export VPC_ID="$(
    aws ec2 describe-vpcs \
      --filters "Name=tag:Name,Values=${VPC_NAME}" \
      --query "Vpcs[0].VpcId" \
      --output text
  )"

  if [[ "${VPC_ID}" == "None" ]]; then
    export VPC_ID="$(
      aws ec2 create-vpc \
        --cidr-block "${VPC_CIDR}" \
        --tag-specifications \
        "ResourceType=vpc,Tags=[{Key=Name,Value=${VPC_NAME}}]" \
        --query "Vpc.VpcId" \
        --output text
    )"
  fi

  printf "VPC:      %s\n" "${VPC_ID}"

  aws ec2 modify-vpc-attribute \
    --vpc-id "${VPC_ID}" \
    --enable-dns-support '{"Value":true}'

  aws ec2 modify-vpc-attribute \
    --vpc-id "${VPC_ID}" \
    --enable-dns-hostnames '{"Value":true}'

  _print_header "GET AVAILABILITY ZONES"

  read -r AZ_A AZ_B < <(
    aws ec2 describe-availability-zones \
      --filters "Name=state,Values=available" \
      --query "AvailabilityZones[0:2].ZoneName" \
      --output text
  )

  _print_header "CREATE SUBNETS"

  export SUBNET_A_ID="$(
    aws ec2 describe-subnets \
      --filters \
      "Name=tag:Name,Values=${SUBNET_A_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "Subnets[0].SubnetId" \
      --output text
  )"

  if [[ "${SUBNET_A_ID}" == "None" ]]; then
    export SUBNET_A_ID="$(
      aws ec2 create-subnet \
        --vpc-id "${VPC_ID}" \
        --cidr-block "${SUBNET_A_CIDR}" \
        --availability-zone "${AZ_A}" \
        --tag-specifications \
        "ResourceType=subnet,Tags=[{Key=Name,Value=${SUBNET_A_NAME}}]" \
        --query "Subnet.SubnetId" \
        --output text
    )"
  fi

  export SUBNET_B_ID="$(
    aws ec2 describe-subnets \
      --filters \
      "Name=tag:Name,Values=${SUBNET_B_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "Subnets[0].SubnetId" \
      --output text
  )"

  if [[ "${SUBNET_B_ID}" == "None" ]]; then
    export SUBNET_B_ID="$(
      aws ec2 create-subnet \
        --vpc-id "${VPC_ID}" \
        --cidr-block "${SUBNET_B_CIDR}" \
        --availability-zone "${AZ_B}" \
        --tag-specifications \
        "ResourceType=subnet,Tags=[{Key=Name,Value=${SUBNET_B_NAME}}]" \
        --query "Subnet.SubnetId" \
        --output text
    )"
  fi

  printf "Subnet A: %s (%s)\n" "${SUBNET_A_ID}" "${AZ_A}"
  printf "Subnet B: %s (%s)\n" "${SUBNET_B_ID}" "${AZ_B}"

  _print_header "CONFIGURE PUBLIC SUBNETS"

  aws ec2 modify-subnet-attribute \
    --subnet-id "${SUBNET_A_ID}" \
    --map-public-ip-on-launch

  aws ec2 modify-subnet-attribute \
    --subnet-id "${SUBNET_B_ID}" \
    --map-public-ip-on-launch

  _print_header "CREATE INTERNET GATEWAY"

  export IGW_ID="$(
    aws ec2 describe-internet-gateways \
      --filters \
      "Name=tag:Name,Values=${IGW_NAME}" \
      "Name=attachment.vpc-id,Values=${VPC_ID}" \
      --query "InternetGateways[0].InternetGatewayId" \
      --output text
  )"

  if [[ "${IGW_ID}" == "None" ]]; then
    export IGW_ID="$(
      aws ec2 create-internet-gateway \
        --tag-specifications \
        "ResourceType=internet-gateway,Tags=[{Key=Name,Value=${IGW_NAME}}]" \
        --query "InternetGateway.InternetGatewayId" \
        --output text
    )"

    aws ec2 attach-internet-gateway \
      --vpc-id "${VPC_ID}" \
      --internet-gateway-id "${IGW_ID}"
  fi

  _print_header "CREATE ROUTE TABLE"

  export ROUTE_TABLE_ID="$(
    aws ec2 describe-route-tables \
      --filters \
      "Name=tag:Name,Values=${ROUTE_TABLE_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "RouteTables[0].RouteTableId" \
      --output text
  )"

  if [[ "${ROUTE_TABLE_ID}" == "None" ]]; then
    export ROUTE_TABLE_ID="$(
      aws ec2 create-route-table \
        --vpc-id "${VPC_ID}" \
        --tag-specifications \
        "ResourceType=route-table,Tags=[{Key=Name,Value=${ROUTE_TABLE_NAME}}]" \
        --query "RouteTable.RouteTableId" \
        --output text
    )"
  fi

  _print_header "CREATE INTERNET ROUTE"

  if ! aws ec2 describe-route-tables \
    --route-table-ids "${ROUTE_TABLE_ID}" \
    --query "RouteTables[0].Routes[?DestinationCidrBlock=='0.0.0.0/0'] | [0].GatewayId" \
    --output text |
    grep -q "^${IGW_ID}$"; then

    aws ec2 create-route \
      --route-table-id "${ROUTE_TABLE_ID}" \
      --destination-cidr-block "0.0.0.0/0" \
      --gateway-id "${IGW_ID}"
  fi

  _print_header "ASSOCIATE SUBNETS"

  if ! aws ec2 describe-route-tables \
    --route-table-ids "${ROUTE_TABLE_ID}" \
    --query "RouteTables[0].Associations[].SubnetId" \
    --output text |
    grep -qw "${SUBNET_A_ID}"; then

    aws ec2 associate-route-table \
      --route-table-id "${ROUTE_TABLE_ID}" \
      --subnet-id "${SUBNET_A_ID}"
  fi

  if ! aws ec2 describe-route-tables \
    --route-table-ids "${ROUTE_TABLE_ID}" \
    --query "RouteTables[0].Associations[].SubnetId" \
    --output text |
    grep -qw "${SUBNET_B_ID}"; then

    aws ec2 associate-route-table \
      --route-table-id "${ROUTE_TABLE_ID}" \
      --subnet-id "${SUBNET_B_ID}"
  fi

  _print_header "CREATE IAM ROLES"

  export CLUSTER_ROLE_NAME="${CLUSTER_NAME}-cluster-role"
  export NODE_ROLE_NAME="${CLUSTER_NAME}-node-role"

  if ! aws iam get-role \
    --role-name "${CLUSTER_ROLE_NAME}" \
    >/dev/null 2>&1; then

    aws iam create-role \
      --role-name "${CLUSTER_ROLE_NAME}" \
      --assume-role-policy-document '{
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "eks.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }'
  fi

  aws iam attach-role-policy \
    --role-name "${CLUSTER_ROLE_NAME}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"

  if ! aws iam get-role \
    --role-name "${NODE_ROLE_NAME}" \
    >/dev/null 2>&1; then

    aws iam create-role \
      --role-name "${NODE_ROLE_NAME}" \
      --assume-role-policy-document '{
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "ec2.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      }'
  fi

  aws iam attach-role-policy \
    --role-name "${NODE_ROLE_NAME}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy"

  aws iam attach-role-policy \
    --role-name "${NODE_ROLE_NAME}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryPullOnly"

  aws iam attach-role-policy \
    --role-name "${NODE_ROLE_NAME}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy"

  export CLUSTER_ROLE_ARN="$(
    aws iam get-role \
      --role-name "${CLUSTER_ROLE_NAME}" \
      --query "Role.Arn" \
      --output text
  )"

  export NODE_ROLE_ARN="$(
    aws iam get-role \
      --role-name "${NODE_ROLE_NAME}" \
      --query "Role.Arn" \
      --output text
  )"

  _print_header "CREATE EKS CLUSTER"

  if ! aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    >/dev/null 2>&1; then

    aws eks create-cluster \
      --name "${CLUSTER_NAME}" \
      --kubernetes-version "${KUBERNETES_VERSION}" \
      --role-arn "${CLUSTER_ROLE_ARN}" \
      --resources-vpc-config \
      "subnetIds=${SUBNET_A_ID},${SUBNET_B_ID}"
  fi

  _print_header "WAIT FOR EKS CONTROL PLANE (MAY TAKE ~10 MINUTES, NOW: $(date +'%F %T'))"

  aws eks wait cluster-active \
    --name "${CLUSTER_NAME}"

  _print_header "CREATE MANAGED WORKER NODES"

  if ! aws eks describe-nodegroup \
    --cluster-name "${CLUSTER_NAME}" \
    --nodegroup-name "${NODEGROUP_NAME}" \
    >/dev/null 2>&1; then

    aws eks create-nodegroup \
      --cluster-name "${CLUSTER_NAME}" \
      --nodegroup-name "${NODEGROUP_NAME}" \
      --node-role "${NODE_ROLE_ARN}" \
      --subnets "${SUBNET_A_ID}" "${SUBNET_B_ID}" \
      --scaling-config "minSize=2,maxSize=2,desiredSize=2" \
      --instance-types "${NODE_INSTANCE_TYPE}" \
      --capacity-type "ON_DEMAND"
  fi

  _print_header "WAIT FOR MANAGED WORKER NODES (MAY TAKE ~5 MINUTES, NOW: $(date +'%F %T'))"

  aws eks wait nodegroup-active \
    --cluster-name "${CLUSTER_NAME}" \
    --nodegroup-name "${NODEGROUP_NAME}"

  printf "Cluster:  %s\n" "${CLUSTER_NAME}"
  printf "Workers:  %s\n" "${NODEGROUP_NAME}"

  _print_header "SETTING KUBECONFIG"

  aws eks update-kubeconfig \
    --region "${AWS_REGION}" \
    --name "${CLUSTER_NAME}" \
    --alias "${CLUSTER_NAME}"
}

cluster:kind:delete() {
  kind delete cluster --name "${CLUSTER_NAME}"
}

cluster:delete() {
  export NODEGROUP_NAME="${CLUSTER_NAME}-workers"

  export CLUSTER_ROLE_NAME="${CLUSTER_NAME}-cluster-role"
  export NODE_ROLE_NAME="${CLUSTER_NAME}-node-role"
  export EBS_CSI_ROLE_NAME="${CLUSTER_NAME}-ebs-csi-role"
  export EFS_CSI_ROLE_NAME="${CLUSTER_NAME}-efs-csi-role"

  export VPC_NAME="${CLUSTER_NAME}"
  export SUBNET_A_NAME="${CLUSTER_NAME}-subnet-a"
  export SUBNET_B_NAME="${CLUSTER_NAME}-subnet-b"
  export IGW_NAME="${CLUSTER_NAME}-internet-gateway"
  export ROUTE_TABLE_NAME="${CLUSTER_NAME}-route-table"
  export EFS_NAME="${CLUSTER_NAME}-efs"
  export EFS_SECURITY_GROUP_NAME="${CLUSTER_NAME}-efs"

  printf "\nThis will permanently delete the EKS cluster and its demo infrastructure.\n"
  printf "The EFS filesystem and all data stored on it will also be deleted.\n\n"

  read -r -p "Are you sure you want to continue? [y/N] " answer
  [[ "${answer}" =~ ^[Yy]$ ]] || return 0

  _print_header "DELETE MANAGED WORKER NODES"

  if aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${AWS_REGION}" >/dev/null 2>&1; then

    local nodegroups
    local nodegroup_name

    nodegroups=$(aws eks list-nodegroups \
      --cluster-name "${CLUSTER_NAME}" \
      --region "${AWS_REGION}" \
      --query "nodegroups[]" \
      --output text)

    if [[ -n "${nodegroups}" && "${nodegroups}" != "None" ]]; then
      while IFS= read -r nodegroup_name; do
        [ -n "${nodegroup_name}" ] || continue

        printf "Deleting node group: %s\n" "${nodegroup_name}"

        aws eks delete-nodegroup \
          --cluster-name "${CLUSTER_NAME}" \
          --nodegroup-name "${nodegroup_name}" \
          --region "${AWS_REGION}"

        printf "\nWaiting for node group deletion (MAY TAKE ~5 MINUTES, NOW: %s)\n", "$(date +'%F %T')"

        aws eks wait nodegroup-deleted \
          --cluster-name "${CLUSTER_NAME}" \
          --nodegroup-name "${nodegroup_name}" \
          --region "${AWS_REGION}"

        printf "Node group deleted successfully.\n"
      done < <(printf '%s\n' "${nodegroups}" | tr '\t' '\n')
    else
      printf "No managed node groups found.\n"
    fi
  else
    printf "EKS cluster does not exist. Skipping node groups.\n"
  fi

  printf "\n==> Confirm it works:\n\n"

  if aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${AWS_REGION}" >/dev/null 2>&1; then

    aws eks list-nodegroups \
      --cluster-name "${CLUSTER_NAME}" \
      --region "${AWS_REGION}" \
      --output table
  else
    printf "Cluster is already absent.\n"
  fi

  _print_header "DELETE EKS CONTROL PLANE"

  if aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${AWS_REGION}" >/dev/null 2>&1; then

    aws eks delete-cluster \
      --name "${CLUSTER_NAME}" \
      --region "${AWS_REGION}"

    printf "\nWaiting for cluster deletion (MAY TAKE ~5 MINUTES, NOW: %s)\n" \
      "$(date +'%F %T')"

    aws eks wait cluster-deleted \
      --name "${CLUSTER_NAME}" \
      --region "${AWS_REGION}"
  else
    printf "EKS cluster does not exist. Skipping.\n"
  fi

  printf "\n==> Confirm it works:\n\n"

  if aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${AWS_REGION}" >/dev/null 2>&1; then
    printf "Error: EKS cluster still exists.\n" >&2
    return 1
  fi

  printf "EKS cluster successfully deleted.\n"

  _print_header "DELETE EFS MOUNT TARGETS"

  export EFS_FILE_SYSTEM_ID="$(
    aws efs describe-file-systems \
      --query "FileSystems[?Tags[?Key=='Name' && Value=='${EFS_NAME}']].FileSystemId | [0]" \
      --output text
  )"

  if [ "${EFS_FILE_SYSTEM_ID}" != "None" ]; then
    local mount_targets
    local mount_target_id

    mount_targets=$(aws efs describe-mount-targets \
      --file-system-id "${EFS_FILE_SYSTEM_ID}" \
      --query "MountTargets[].MountTargetId" \
      --output text)

    if [[ -n "${mount_targets}" && "${mount_targets}" != "None" ]]; then
      while IFS= read -r mount_target_id; do
        [ -n "${mount_target_id}" ] || continue

        printf "Deleting mount target: %s\n" "${mount_target_id}"

        aws efs delete-mount-target \
          --mount-target-id "${mount_target_id}" \
          --region "${AWS_REGION}"
      done < <(printf '%s\n' "${mount_targets}" | tr '\t' '\n')

      printf "Waiting for mount target deletion...\n"

      for _attempt in {1..60}; do
        mount_targets=$(aws efs describe-mount-targets \
          --file-system-id "${EFS_FILE_SYSTEM_ID}" \
          --query "MountTargets[].MountTargetId" \
          --output text)

        [[ -z "${mount_targets}" || "${mount_targets}" == "None" ]] && break
        sleep 10
      done

      if [[ -n "${mount_targets}" && "${mount_targets}" != "None" ]]; then
        printf "ERROR: EFS mount targets still exist: %s\n" "${mount_targets}" >&2
        return 1
      fi
    fi
  else
    printf "EFS filesystem does not exist. Skipping mount targets.\n"
  fi

  printf "\n==> Confirm it works:\n\n"

  if [ "${EFS_FILE_SYSTEM_ID}" != "None" ]; then
    aws efs describe-mount-targets \
      --file-system-id "${EFS_FILE_SYSTEM_ID}" \
      --query "MountTargets[]" \
      --output table
  else
    printf "No EFS filesystem found.\n"
  fi

  _print_header "DELETE EFS FILE SYSTEM"

  if [ "${EFS_FILE_SYSTEM_ID}" != "None" ]; then
    aws efs delete-file-system \
      --file-system-id "${EFS_FILE_SYSTEM_ID}" \
      --region "${AWS_REGION}"

    printf "Waiting for EFS filesystem deletion...\n"

    for _attempt in {1..60}; do
      if ! aws efs describe-file-systems \
        --file-system-id "${EFS_FILE_SYSTEM_ID}" \
        --region "${AWS_REGION}" >/dev/null 2>&1; then
        break
      fi

      sleep 10
    done

    if aws efs describe-file-systems \
      --file-system-id "${EFS_FILE_SYSTEM_ID}" \
      --region "${AWS_REGION}" >/dev/null 2>&1; then
      printf "ERROR: EFS filesystem still exists.\n" >&2
      return 1
    fi
  else
    printf "EFS filesystem does not exist. Skipping.\n"
  fi

  printf "\n==> Confirm it works:\n\n"
  printf "EFS filesystem deleted.\n"

  _print_header "DELETE EFS SECURITY GROUP"

  export VPC_ID="$(
    aws ec2 describe-vpcs \
      --filters "Name=tag:Name,Values=${VPC_NAME}" \
      --query "Vpcs[0].VpcId" \
      --output text
  )"

  if [ "${VPC_ID}" != "None" ]; then
    export EFS_SECURITY_GROUP_ID="$(
      aws ec2 describe-security-groups \
        --filters \
        "Name=group-name,Values=${EFS_SECURITY_GROUP_NAME}" \
        "Name=vpc-id,Values=${VPC_ID}" \
        --query "SecurityGroups[0].GroupId" \
        --output text
    )"

    if [ "${EFS_SECURITY_GROUP_ID}" != "None" ]; then
      aws ec2 delete-security-group \
        --group-id "${EFS_SECURITY_GROUP_ID}" \
        --region "${AWS_REGION}"
    fi
  fi

  printf "\n==> Confirm it works:\n\n"

  if [[ "${VPC_ID}" != "None" ]]; then
    aws ec2 describe-security-groups \
      --filters \
      "Name=group-name,Values=${EFS_SECURITY_GROUP_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "SecurityGroups[].GroupId" \
      --output table
  else
    printf "VPC does not exist.\n"
  fi

  _print_header "DELETE IAM ROLES"

  _delete_iam_role "${EFS_CSI_ROLE_NAME}"
  _delete_iam_role "${EBS_CSI_ROLE_NAME}"
  _delete_iam_role "${NODE_ROLE_NAME}"
  _delete_iam_role "${CLUSTER_ROLE_NAME}"

  printf "\n==> Confirm it works:\n\n"

  for role_name in \
    "${CLUSTER_ROLE_NAME}" \
    "${NODE_ROLE_NAME}" \
    "${EBS_CSI_ROLE_NAME}" \
    "${EFS_CSI_ROLE_NAME}"; do
    if aws iam get-role --role-name "${role_name}" >/dev/null 2>&1; then
      printf "ERROR: IAM role still exists: %s\n" "${role_name}" >&2
      return 1
    fi

    printf "Deleted: %s\n" "${role_name}"
  done

  _print_header "DELETE VPC RESOURCES"

  if [ "${VPC_ID}" != "None" ]; then
    local subnet_id
    local route_table_id
    local association_id
    local internet_gateway_id
    local eni_count
    local eni_ids

    _print_header "WAIT FOR NETWORK INTERFACES"

    for _attempt in {1..60}; do
      eni_count=$(aws ec2 describe-network-interfaces \
        --filters "Name=vpc-id,Values=${VPC_ID}" \
        --query "length(NetworkInterfaces)" \
        --output text)

      [ "${eni_count}" == "0" ] && break
      sleep 10
    done

    if [ "${eni_count}" != "0" ]; then
      eni_ids=$(aws ec2 describe-network-interfaces \
        --filters "Name=vpc-id,Values=${VPC_ID}" \
        --query "NetworkInterfaces[].NetworkInterfaceId" \
        --output text)

      printf "ERROR: Network interfaces still exist in ${VPC_ID}: %s\n" \
        "${eni_ids}" >&2
      return 1
    fi

    printf "\n==> Confirm it works:\n\n"
    printf "No network interfaces remain in %s.\n" "${VPC_ID}"

    _print_header "DELETE INTERNET GATEWAY"

    internet_gateway_id=$(aws ec2 describe-internet-gateways \
      --filters \
      "Name=tag:Name,Values=${IGW_NAME}" \
      "Name=attachment.vpc-id,Values=${VPC_ID}" \
      --query "InternetGateways[0].InternetGatewayId" \
      --output text)

    if [ "${internet_gateway_id}" != "None" ]; then
      aws ec2 detach-internet-gateway \
        --internet-gateway-id "${internet_gateway_id}" \
        --vpc-id "${VPC_ID}"

      aws ec2 delete-internet-gateway \
        --internet-gateway-id "${internet_gateway_id}"
    fi

    printf "\n==> Confirm it works:\n\n"
    aws ec2 describe-internet-gateways \
      --filters "Name=attachment.vpc-id,Values=${VPC_ID}" \
      --query "InternetGateways[].InternetGatewayId" \
      --output table

    _print_header "DELETE SUBNETS"

    for subnet_name in "${SUBNET_A_NAME}" "${SUBNET_B_NAME}"; do
      subnet_id=$(aws ec2 describe-subnets \
        --filters \
        "Name=tag:Name,Values=${subnet_name}" \
        "Name=vpc-id,Values=${VPC_ID}" \
        --query "Subnets[0].SubnetId" \
        --output text)

      if [ "${subnet_id}" != "None" ]; then
        printf "Deleting subnet: %s (%s)\n" "${subnet_name}" "${subnet_id}"

        aws ec2 delete-subnet \
          --subnet-id "${subnet_id}"
      fi
    done

    printf "\n==> Confirm it works:\n\n"
    aws ec2 describe-subnets \
      --filters "Name=vpc-id,Values=${VPC_ID}" \
      --query "Subnets[].SubnetId" \
      --output table

    _print_header "DELETE ROUTE TABLE"

    route_table_id=$(aws ec2 describe-route-tables \
      --filters \
      "Name=tag:Name,Values=${ROUTE_TABLE_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "RouteTables[0].RouteTableId" \
      --output text)

    if [ "${route_table_id}" != "None" ]; then
      local associations

      associations=$(aws ec2 describe-route-tables \
        --route-table-ids "${route_table_id}" \
        --query "RouteTables[0].Associations[?Main==\`false\`].RouteTableAssociationId" \
        --output text)

      if [[ -n "${associations}" && "${associations}" != "None" ]]; then
        read -r -a association_ids <<<"${associations}"

        for association_id in "${association_ids[@]}"; do
          aws ec2 disassociate-route-table \
            --association-id "${association_id}"
        done
      fi

      aws ec2 delete-route-table \
        --route-table-id "${route_table_id}"
    fi

    printf "\n==> Confirm it works:\n\n"
    aws ec2 describe-route-tables \
      --filters \
      "Name=tag:Name,Values=${ROUTE_TABLE_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "RouteTables[].RouteTableId" \
      --output table

    _print_header "DELETE SECURITY GROUPS"

    security_group_ids="$(
      aws ec2 describe-security-groups \
        --filters "Name=vpc-id,Values=${VPC_ID}" \
        --query "SecurityGroups[?GroupName!='default'].GroupId" \
        --output text
    )"

    for security_group_id in ${security_group_ids}; do
      aws ec2 delete-security-group \
        --group-id "${security_group_id}"
    done

    _print_header "DELETE VPC"

    aws ec2 delete-vpc \
      --vpc-id "${VPC_ID}" \
      --region "${AWS_REGION}"

    printf "\n==> Confirm it works:\n\n"

    if aws ec2 describe-vpcs \
      --vpc-ids "${VPC_ID}" \
      --region "${AWS_REGION}" >/dev/null 2>&1; then
      printf "Error: VPC still exists: %s\n" "${VPC_ID}" >&2
      return 1
    fi

    printf "VPC successfully deleted: %s\n" "${VPC_ID}"
  else
    printf "VPC does not exist. Skipping VPC cleanup.\n"
  fi

  _print_header "REMOVE KUBECONFIG ENTRIES"

  local account_id
  local cluster_arn

  account_id=$(aws sts get-caller-identity \
    --query "Account" \
    --output text)

  cluster_arn="arn:aws:eks:${AWS_REGION}:${account_id}:cluster/${CLUSTER_NAME}"

  kubectl config delete-context "${CLUSTER_NAME}" >/dev/null 2>&1 || true
  kubectl config delete-cluster "${cluster_arn}" >/dev/null 2>&1 || true
  kubectl config unset "users.${cluster_arn}" >/dev/null 2>&1 || true

  printf "\n==> Confirm it works:\n\n"

  kubectl config get-contexts

  _print_header "EKS CLEANUP COMPLETE"
  printf "Cluster and its dedicated AWS infrastructure have been deleted.\n"
}

cluster:install-dependencies() {
  _print_header "CREATE EBS CSI IAM ROLE"

  export EBS_CSI_ROLE_NAME="${CLUSTER_NAME}-ebs-csi-role"

  if ! aws iam get-role \
    --role-name "${EBS_CSI_ROLE_NAME}" \
    >/dev/null 2>&1; then

    aws iam create-role \
      --role-name "${EBS_CSI_ROLE_NAME}" \
      --assume-role-policy-document '{
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllowEksAuthToAssumeRoleForPodIdentity",
          "Effect": "Allow",
          "Principal": {
            "Service": "pods.eks.amazonaws.com"
          },
          "Action": [
            "sts:AssumeRole",
            "sts:TagSession"
          ]
        }
      ]
    }'
  fi

  aws iam attach-role-policy \
    --role-name "${EBS_CSI_ROLE_NAME}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonEBSCSIDriverPolicyV2"

  export EBS_CSI_ROLE_ARN="$(
    aws iam get-role \
      --role-name "${EBS_CSI_ROLE_NAME}" \
      --query "Role.Arn" \
      --output text
  )"

  _print_header "INSTALL EKS POD IDENTITY AGENT"

  if ! aws eks describe-addon \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "eks-pod-identity-agent" \
    >/dev/null 2>&1; then

    aws eks create-addon \
      --cluster-name "${CLUSTER_NAME}" \
      --addon-name "eks-pod-identity-agent"
  fi

  _print_header "WAIT FOR EKS POD IDENTITY AGENT"

  aws eks wait addon-active \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "eks-pod-identity-agent"

  _print_header "INSTALL EBS CSI DRIVER ADD-ON"

  if ! aws eks describe-addon \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "aws-ebs-csi-driver" \
    >/dev/null 2>&1; then

    aws eks create-addon \
      --cluster-name "${CLUSTER_NAME}" \
      --addon-name "aws-ebs-csi-driver" \
      --pod-identity-associations \
      "[{\"serviceAccount\":\"ebs-csi-controller-sa\",\"roleArn\":\"${EBS_CSI_ROLE_ARN}\"}]"
  fi

  _print_header "WAIT FOR EBS ADD-ON (MAY TAKE ~5 MINUTES, NOW: $(date +'%F %T'))"

  aws eks wait addon-active \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "aws-ebs-csi-driver"

  printf "\n==> Confirm it works:\n\n"
  kubectl get pods \
    --namespace kube-system \
    --selector "app.kubernetes.io/name=aws-ebs-csi-driver"

  kubectl get csidriver "ebs.csi.aws.com"

  _print_header "GET EKS NETWORKING"

  export VPC_ID="$(
    aws ec2 describe-vpcs \
      --filters "Name=tag:Name,Values=${CLUSTER_NAME}" \
      --query "Vpcs[0].VpcId" \
      --output text
  )"

  export SUBNET_A_NAME="${CLUSTER_NAME}-subnet-a"
  export SUBNET_B_NAME="${CLUSTER_NAME}-subnet-b"

  export SUBNET_A_ID="$(
    aws ec2 describe-subnets \
      --filters \
      "Name=tag:Name,Values=${SUBNET_A_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "Subnets[0].SubnetId" \
      --output text
  )"

  export SUBNET_B_ID="$(
    aws ec2 describe-subnets \
      --filters \
      "Name=tag:Name,Values=${SUBNET_B_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "Subnets[0].SubnetId" \
      --output text
  )"

  _print_header "CREATE EFS FILE SYSTEM"

  export EFS_NAME="${CLUSTER_NAME}-efs"

  export EFS_FILE_SYSTEM_ID="$(
    aws efs describe-file-systems \
      --query "FileSystems[?Tags[?Key=='Name' && Value=='${EFS_NAME}']].FileSystemId | [0]" \
      --output text
  )"

  if [[ "${EFS_FILE_SYSTEM_ID}" == "None" ]]; then
    export EFS_FILE_SYSTEM_ID="$(
      aws efs create-file-system \
        --performance-mode "generalPurpose" \
        --throughput-mode "elastic" \
        --tags "Key=Name,Value=${EFS_NAME}" \
        --query "FileSystemId" \
        --output text
    )"
  fi

  _print_header "CREATE EFS SECURITY GROUP"

  export EFS_SECURITY_GROUP_NAME="${CLUSTER_NAME}-efs"

  export EFS_SECURITY_GROUP_ID="$(
    aws ec2 describe-security-groups \
      --filters \
      "Name=group-name,Values=${EFS_SECURITY_GROUP_NAME}" \
      "Name=vpc-id,Values=${VPC_ID}" \
      --query "SecurityGroups[0].GroupId" \
      --output text
  )"

  if [[ "${EFS_SECURITY_GROUP_ID}" == "None" ]]; then
    export EFS_SECURITY_GROUP_ID="$(
      aws ec2 create-security-group \
        --group-name "${EFS_SECURITY_GROUP_NAME}" \
        --description "Allow EKS nodes to access EFS" \
        --vpc-id "${VPC_ID}" \
        --tag-specifications \
        "ResourceType=security-group,Tags=[{Key=Name,Value=${EFS_SECURITY_GROUP_NAME}}]" \
        --query "GroupId" \
        --output text
    )"
  fi

  _print_header "CONFIGURE EFS SECURITY GROUP"

  export EKS_SECURITY_GROUP_ID="$(
    aws eks describe-cluster \
      --name "${CLUSTER_NAME}" \
      --query "cluster.resourcesVpcConfig.clusterSecurityGroupId" \
      --output text
  )"

  export EFS_SECURITY_GROUP_RULE_COUNT="$(
    aws ec2 describe-security-group-rules \
      --filters \
      "Name=group-id,Values=${EFS_SECURITY_GROUP_ID}" \
      --query "length(SecurityGroupRules[?IsEgress==\`false\` && IpProtocol=='tcp' && FromPort==\`2049\` && ToPort==\`2049\` && ReferencedGroupInfo.GroupId=='${EKS_SECURITY_GROUP_ID}'])" \
      --output text
  )"

  if [[ "${EFS_SECURITY_GROUP_RULE_COUNT}" == "0" ]]; then
    aws ec2 authorize-security-group-ingress \
      --group-id "${EFS_SECURITY_GROUP_ID}" \
      --protocol "tcp" \
      --port "2049" \
      --source-group "${EKS_SECURITY_GROUP_ID}"
  fi

  _print_header "CREATE EFS MOUNT TARGETS"

  export EFS_MOUNT_TARGET_A_ID="$(
    aws efs describe-mount-targets \
      --file-system-id "${EFS_FILE_SYSTEM_ID}" \
      --query "MountTargets[?SubnetId=='${SUBNET_A_ID}'].MountTargetId | [0]" \
      --output text
  )"

  if [[ "${EFS_MOUNT_TARGET_A_ID}" == "None" ]]; then
    export EFS_MOUNT_TARGET_A_ID="$(
      aws efs create-mount-target \
        --file-system-id "${EFS_FILE_SYSTEM_ID}" \
        --subnet-id "${SUBNET_A_ID}" \
        --security-groups "${EFS_SECURITY_GROUP_ID}" \
        --query "MountTargetId" \
        --output text
    )"
  fi

  export EFS_MOUNT_TARGET_B_ID="$(
    aws efs describe-mount-targets \
      --file-system-id "${EFS_FILE_SYSTEM_ID}" \
      --query "MountTargets[?SubnetId=='${SUBNET_B_ID}'].MountTargetId | [0]" \
      --output text
  )"

  if [[ "${EFS_MOUNT_TARGET_B_ID}" == "None" ]]; then
    export EFS_MOUNT_TARGET_B_ID="$(
      aws efs create-mount-target \
        --file-system-id "${EFS_FILE_SYSTEM_ID}" \
        --subnet-id "${SUBNET_B_ID}" \
        --security-groups "${EFS_SECURITY_GROUP_ID}" \
        --query "MountTargetId" \
        --output text
    )"
  fi

  printf "\n==> Confirm it works:\n\n"

  aws efs describe-mount-targets \
    --file-system-id "${EFS_FILE_SYSTEM_ID}" \
    --query "MountTargets[].{ID:MountTargetId,Subnet:SubnetId,AZ:AvailabilityZoneName,State:LifeCycleState}" \
    --output table

  _print_header "INSTALL EKS POD IDENTITY AGENT"

  if ! aws eks describe-addon \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "eks-pod-identity-agent" \
    >/dev/null 2>&1; then

    aws eks create-addon \
      --cluster-name "${CLUSTER_NAME}" \
      --addon-name "eks-pod-identity-agent"
  fi

  aws eks wait addon-active \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "eks-pod-identity-agent"

  _print_header "CREATE EFS CSI IAM ROLE"

  export EFS_CSI_ROLE_NAME="${CLUSTER_NAME}-efs-csi-role"

  if ! aws iam get-role \
    --role-name "${EFS_CSI_ROLE_NAME}" \
    >/dev/null 2>&1; then

    aws iam create-role \
      --role-name "${EFS_CSI_ROLE_NAME}" \
      --assume-role-policy-document '{
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "AllowEksAuthToAssumeRoleForPodIdentity",
            "Effect": "Allow",
            "Principal": {
              "Service": "pods.eks.amazonaws.com"
            },
            "Action": [
              "sts:AssumeRole",
              "sts:TagSession"
            ]
          }
        ]
      }'
  fi

  aws iam attach-role-policy \
    --role-name "${EFS_CSI_ROLE_NAME}" \
    --policy-arn "arn:aws:iam::aws:policy/service-role/AmazonEFSCSIDriverPolicy"

  export EFS_CSI_ROLE_ARN="$(
    aws iam get-role \
      --role-name "${EFS_CSI_ROLE_NAME}" \
      --query "Role.Arn" \
      --output text
  )"

  _print_header "INSTALL EFS CSI DRIVER ADD-ON"

  if ! aws eks describe-addon \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "aws-efs-csi-driver" \
    >/dev/null 2>&1; then

    aws eks create-addon \
      --cluster-name "${CLUSTER_NAME}" \
      --addon-name "aws-efs-csi-driver" \
      --pod-identity-associations \
      "[{\"serviceAccount\":\"efs-csi-controller-sa\",\"roleArn\":\"${EFS_CSI_ROLE_ARN}\"}]"
  fi

  aws eks wait addon-active \
    --cluster-name "${CLUSTER_NAME}" \
    --addon-name "aws-efs-csi-driver"

  printf "\n==> Confirm it works:\n\n"
  kubectl get pods \
    --namespace kube-system \
    --selector "app.kubernetes.io/name=aws-efs-csi-driver"

  _print_header "INSTALL GATEWAY API"
  kubectl apply \
    -f "https://github.com/kubernetes-sigs/gateway-api/releases/download/v${KUBERNETES_GATEWAY_API_VERSION}/standard-install.yaml"

  printf "\n==> Confirm it works:\n\n"
  kubectl get crd gateways.gateway.networking.k8s.io

  # _print_header "INSTALL NGINX GATEWAY FABRIC"
  # helm upgrade --install ngf \
  #   oci://ghcr.io/nginx/charts/nginx-gateway-fabric \
  #   --version "${NGINX_GATEWAY_FABRIC_VERSION}" \
  #   --create-namespace \
  #   --namespace nginx-gateway \
  #   --set nginx.service.type=NodePort \
  #   --set-json 'nginx.service.nodePorts=[{"port":31437,"listenerPort":80}]'

  # FOR EKS NO LOAD BALANCER
  _print_header "INSTALL NGINX GATEWAY FABRIC"
  helm upgrade --install ngf \
    oci://ghcr.io/nginx/charts/nginx-gateway-fabric \
    --version "${NGINX_GATEWAY_FABRIC_VERSION}" \
    --create-namespace \
    --namespace nginx-gateway \
    --set "nginx.service.type=NodePort"

  printf "\n==> Confirm it works:\n\n"
  kubectl rollout status deployment/ngf-nginx-gateway-fabric \
    --namespace nginx-gateway --timeout=120s

  # ONLY NEEDED FOR KIND
  # _print_header "INSTALL NFS CSI DRIVER"
  # helm repo add csi-driver-nfs https://raw.githubusercontent.com/kubernetes-csi/csi-driver-nfs/master/charts
  # helm repo update
  # helm upgrade --install csi-driver-nfs csi-driver-nfs/csi-driver-nfs \
  #   --version "${NFS_CSI_DRIVER_VERSION}" \
  #   --namespace kube-system
  #
  # printf "\n==> Confirm it works:\n\n"
  # kubectl rollout status deployment/csi-nfs-controller \
  #   --namespace kube-system --timeout=120s
  # kubectl rollout status daemonset/csi-nfs-node \
  #   --namespace kube-system --timeout=120s
}

cluster:deploy-core() {
  _print_header "CREATE NAMESPACES"
  kubectl create namespace apps --dry-run=client -o yaml | kubectl apply -f -
  kubectl create namespace gateway-system --dry-run=client -o yaml | kubectl apply -f -

  # ONLY NEEDED FOR KIND
  # _print_header "DEPLOY NFS SERVER"
  # kubectl:apply 01-core/01-nfs.yaml
  #
  # printf "\n==> Confirm it works:\n\n"
  # kubectl rollout status deployment/nfs-server --timeout=120s

  # ONLY NEEDED FOR EKS
  _print_header "DEPLOY EBS AND EFS STORAGE"
  export EFS_FILE_SYSTEM_ID="$(
    aws efs describe-file-systems \
      --query "FileSystems[?Tags[?Key=='Name' && Value=='${CLUSTER_NAME}-efs']].FileSystemId | [0]" \
      --output text
  )"

  if [ "${EFS_FILE_SYSTEM_ID}" == "None" ]; then
    printf "ERROR: EFS filesystem not found\n" >&2
    return 1
  fi

  kubectl:apply 01-core/01-ebs-and-efs.yaml

  printf "\n==> Confirm it works:\n\n"
  kubectl get storageclass "${K8S_STORAGE_CLASS_NAME}"

  _print_header "DEPLOY GATEWAY"
  kubectl:apply 01-core/02-gateway.yaml --namespace gateway-system

  printf "\n==> Confirm it works:\n\n"
  kubectl wait \
    gateway/public \
    --namespace gateway-system \
    --for=condition=Programmed --timeout=120s
}

cluster:install-plakar-operator() {
  _print_header "INSTALL PLAKAR KUBERNETES OPERATOR"
  helm upgrade --install plakar-operator \
    oci://ghcr.io/plakarkorp/charts/plakar-operator \
    --version "${PLAKAR_KUBERNETES_OPERATOR_VERSION}" \
    --create-namespace \
    --namespace plakar-operator-system

  printf "\n==> Confirm it works:\n\n"
  kubectl rollout status deployment/plakar-operator-controller-manager \
    --namespace plakar-operator-system --timeout=120s
}

cluster:configure-plakar-access() {
  local tmp_dir
  local tmp_flattened_kubeconfig
  local token

  tmp_dir="$(mktemp -d)"
  tmp_flattened_kubeconfig="${tmp_dir}/kubeconfig-flat"

  trap 'rm -rf "${tmp_dir}"' RETURN

  _print_header "CONFIGURE PLAKAR ACCESS"
  kubectl --namespace apps apply -f 03-plakar-operator/00-rbac.yaml

  # Create a long-lived ServiceAccount token, rotate this as needed.
  kubectl --namespace apps apply -f - <<'EOF'
apiVersion: "v1"
kind: "Secret"
metadata:
  name: "plakar-pvc-token"
  annotations:
    kubernetes.io/service-account.name: "plakar-pvc"
type: "kubernetes.io/service-account-token"
EOF

  for _attempt in {1..30}; do
    token=$(kubectl --namespace apps get secret plakar-pvc-token \
      --output jsonpath="{.data.token}" | base64 --decode)

    [ -n "${token}" ] && break
    sleep 1
  done

  if [ -z "${token}" ]; then
    error "Error: ServiceAccount token was not populated" >&2
    return 1
  fi

  # Generate a flattened kubeconfig for the PCP instance.
  _print_header "CREATE PLAKAR KUBECONFIG SECRET"

  aws eks update-kubeconfig \
    --name "${CLUSTER_NAME}" \
    --region "${AWS_DEFAULT_REGION}" \
    --kubeconfig "${tmp_dir}/kubeconfig" 1>/dev/null

  kubectl config view \
    --raw \
    --minify \
    --flatten \
    --kubeconfig "${tmp_dir}/kubeconfig" \
    >"${tmp_flattened_kubeconfig}"

  # TODO: DELETE ME IF THE ABOVE WORKS
  # aws eks update-kubeconfig \
  #   --name "${CLUSTER_NAME}" \
  #   --region "${AWS_DEFAULT_REGION}" \
  #   --kubeconfig "${tmp_flattened_kubeconfig}" 1>/dev/null
  #
  # kubectl config view \
  #   --raw \
  #   --minify \
  #   --flatten \
  #   --kubeconfig "${tmp_dir}/kubeconfig" \
  #   >"${tmp_flattened_kubeconfig}"

  PLAKAR_TOKEN="${token}" yq -i \
    '.users[0].user = {"token": strenv(PLAKAR_TOKEN)}' \
    "${tmp_flattened_kubeconfig}"

  kubectl create secret generic "${CLUSTER_NAME}-cluster" \
    --namespace apps \
    --from-file=kubeConfig="${tmp_flattened_kubeconfig}" \
    --dry-run=client \
    --output yaml |
    kubectl apply -f -

  printf "\n==> Confirm it works:\n\n"
  kubectl --kubeconfig "${tmp_flattened_kubeconfig}" \
    auth can-i get persistentvolumeclaims --namespace apps
  kubectl --kubeconfig "${tmp_flattened_kubeconfig}" \
    auth can-i create pods --namespace apps
  kubectl --kubeconfig "${tmp_flattened_kubeconfig}" \
    auth can-i create pods/portforward --namespace apps
}

cluster:port-forward() {
  _print_header "FORWARD PORT ${CLUSTER_HOST_PORT}"
  kubectl port-forward \
    --namespace gateway-system \
    service/public-nginx \
    "${CLUSTER_HOST_PORT}:80"
}

kubectl() {
  command kubectl "${@}"
}

kubectl:apply() {
  _kubectl:file apply "${@}"
}

kubectl:delete() {
  _kubectl:file delete "${@}"
}

# -------------------

lint() {
  # Lint all supported file types
  local shellcheck_cmd=(shellcheck)
  local ruff_cmd=(ruff)

  if ! command -v shellcheck >/dev/null 2>&1; then
    local shellcheck_cmd=(docker container run --rm -i -v "${PWD}:/mnt" koalaman/shellcheck:stable)
  fi

  if ! command -v ruff >/dev/null 2>&1; then
    local ruff_cmd=(docker container run --rm -i -v "${PWD}:/io" -u "$(id -u):$(id -g)" ghcr.io/astral-sh/ruff:0.15.11)
  fi

  find . -type f \
    ! -path "./.git/*" \
    ! -path "./.github/*" \
    ! -path "./.ruff_cache/*" \
    ! -path "./_docs/*" \
    ! -path "./_themes/*" \
    ! -path "./_wallpapers/*" \
    ! -path "./mnt/c/*" \
    -exec sh -c 'head -n 1 "${1}" | grep --quiet -E "^(#!.*sh|# shellcheck shell=)"' _ {} \; \
    -exec "${shellcheck_cmd[@]}" {} +

  "${ruff_cmd[@]}" check "${@}"
}

format() {
  # Format all supported file types
  local shfmt_cmd=(shfmt)
  local ruff_cmd=(ruff)

  if ! command -v shfmt >/dev/null 2>&1; then
    local shfmt_cmd=(docker container run --rm -i -v "${PWD}:/mnt" -u "$(id -u):$(id -g)" -w /mnt mvdan/shfmt:v3)
  fi

  if ! command -v ruff >/dev/null 2>&1; then
    local ruff_cmd=(docker container run --rm -i -v "${PWD}:/io" -u "$(id -u):$(id -g)" ghcr.io/astral-sh/ruff:0.15.11)
  fi

  local shfmt_args=("--write")

  for arg in "${@}"; do
    [ "${arg}" == "--check" ] && shfmt_args+=("--diff")

    if [ "${arg}" == "-d" ] || [ "${arg}" == "--diff" ] || [ "${shfmt_args[1]}" == "--diff" ]; then
      unset "shfmt_args[0]"
    fi
  done

  "${shfmt_cmd[@]}" "${shfmt_args[@]}" . .config/zsh/.{aliases,zprofile,zshrc}

  "${ruff_cmd[@]}" check --fix
  "${ruff_cmd[@]}" format "${@}"
}

quality() {
  # Perform all code quality commands together
  lint "${@}"
  format "${@}"
}

ci:test() {
  # Execute Continuous Integration (CI) pipeline
  lint
  format --check --diff
}

help() {
  printf "%s <task> [args]\n\nTasks:\n" "${0}"

  compgen -A function | grep -v "^_" | cat -n

  printf "\nExtended help:\n  Each task has comments for general usage\n"
}

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
